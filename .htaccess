# ===============================================================
# Flight Care - Enterprise SPA Routing, Cloudflare WAF & Security Shield
# Compatible with Hostinger LiteSpeed, Apache & Cloudflare Proxy
# ===============================================================

Options -Indexes +FollowSymLinks

# Ensure Correct MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# ===============================================================
# 1. CLOUDFLARE VISITOR IP RESTORATION & PROXY COMPLIANCE
# ===============================================================
<IfModule mod_remoteip.c>
  RemoteIPHeader CF-Connecting-IP
  RemoteIPTrustedProxy 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
</IfModule>

# ===============================================================
# 2. API & CREDENTIALS PROTECTION SHIELD (Hiding All Source & Config Files)
# ===============================================================

# Block any direct HTTP access to API files, environment files, source code & backups
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env.*|lock|md|ts|tsx|map|key|pem|cert|crt|p12)|api\.js|apiCore\.js|App\.js|package\.json|package-lock\.json|firebase\.json|firestore\.indexes\.json|app\.json|eas\.json|\.env|\.git.*)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block access to dot-hidden files except .htaccess and .well-known
<FilesMatch "^\.(?!well-known|htaccess)">
  Order allow,deny
  Deny from all
</FilesMatch>

# ===============================================================
# 3. URL REWRITES & HOSTING REDIRECTS
# ===============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Immediate 403 Forbidden for anyone scanning for API files or secrets
  RewriteCond %{THE_REQUEST} (\.env|api\.js|apiCore\.js|package\.json|package-lock\.json|firebase\.json|firestore|\.git) [NC]
  RewriteRule ^ - [F,L]

  # Redirect alternate domain flightcare.app or www to primary flightcaresbd.com
  RewriteCond %{HTTP_HOST} ^flightcare\.app$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.flightcare\.app$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.flightcaresbd\.com$ [NC]
  RewriteRule ^(.*)$ https://flightcaresbd.com/$1 [R=301,L]

  # Enforce HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^flightcaresbd\.com$ [NC]
  RewriteRule ^(.*)$ https://flightcaresbd.com/$1 [R=301,L]

  # Allow direct execution of server payment endpoints
  RewriteCond %{REQUEST_URI} ^/api/payment/.*\.php$ [NC]
  RewriteRule ^ - [L]

  # Single Page Application (SPA) Fallback Rewrite
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Brotli Compression (Hostinger LiteSpeed / Apache)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# GZIP / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching Headers for 100/100 Core Web Vitals
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Enterprise Security Headers with HSTS & Cloudflare Defense
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HTTP Strict Transport Security (HSTS - 1 Year)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Connection keep-alive
</IfModule>

# Always serve fresh index.html to guarantee immediate updates on deploy
<Files "index.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</Files>
