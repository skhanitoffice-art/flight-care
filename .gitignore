# Flight Care - Comprehensive Security .gitignore
# Prevents exposure of API credentials, keys, database backups, and environment configs

# 1. Environment & API Secrets
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
local.properties
google-services.json
GoogleService-Info.plist

# 2. API Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.keystore
*.jks
credentials.json
service-account.json
firebase-adminsdk*.json

# 3. Dependencies & Package caches
node_modules/
.pnp
.pnp.js

# 4. Expo & Build Artifacts
.expo/
.expo-shared/
dist/
build/
web-build/
android/.gradle/
android/app/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
*.apk
*.aab
*.ipa

# 5. Production Archives & Backups
*.zip
*.tar.gz
*.tgz
*.bak
*.backup
*.sql
*.sqlite
*.dump

# 6. Internal Scratch & Debug Logs
scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
expo_log.txt

# 7. Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 8. Confidential Credentials, Passwords, Handovers & Exam Papers
*CREDENTIALS*
*credentials*
*Handover*
*handover*
*.pdf
*.docx
*.doc
*.xlsx
*.csv
*config.local.php

# 9. Seeding & Local Test Scripts
scripts/seedFirestore.js
scripts/*.seed.js
scripts/*.local.js


