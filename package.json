{
  "name": "flightcare-rn",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "expo export -p web --output-dir dist",
    "build:hostinger": "expo export -p web --output-dir dist && python scratch/packageHostingerAndWindowsZip.py",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "build:apk": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "build:mobile": "eas build -p all --profile preview",
    "build:android": "expo export -p web --output-dir dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.0.1",
    "@types/react": "~18.2.79",
    "expo": "~51.0.0",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "firebase": "^13.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10",
    "typescript": "~5.3.3"
  }
}
