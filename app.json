        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071A2E"
      }
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "0f343ac3-1f8e-44bb-b889-87a9bf9bb452"
      }
    }
  }
}
