{
  "expo": {
    "name": "FlightCare",
    "slug": "flightcare",
    "owner": "afmshamsulhaque",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
